# Hostinger / LiteSpeed: nette URL's en goede caching voor de Elim landingspagina.

# Forceer HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On

  # https afdwingen
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /bedankt -> /bedankt.html (zonder zichtbare extensie)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Als iemand toch /bedankt.html intikt, laat die gewoon werken (geen redirect-loop)
</IfModule>

# Standaard documenten
DirectoryIndex index.html

# Eigen 404 niet nodig: index gebruikt geen interne links naar niet-bestaande paden.

# Caching: lange cache voor assets met ?v=, korte voor html
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  ExpiresByType image/jpeg               "access plus 30 days"
  ExpiresByType image/webp               "access plus 30 days"
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType image/x-icon             "access plus 30 days"
  ExpiresByType font/woff2               "access plus 90 days"
</IfModule>

# Compressie
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Veiligheidsheaders (mild, niets dat de site breekt)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hostinger LiteSpeed: bedankt-route + cache + compressie

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bestaande bestanden en mappen direct serveren
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /bedankt en /bedankt/ → bedankt.html
  RewriteRule ^bedankt/?$ bedankt.html [L]

  # Overige routes naar index.html (statische single-page)
  RewriteRule . index.html [L]
</IfModule>

# ── Compressie (Brotli + GZIP) ─────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf
</IfModule>

# ── Browser caching (LiteSpeed/Apache mod_expires) ─────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: nooit lang cachen, anders zien bezoekers oude versie
  ExpiresByType text/html "access plus 0 seconds"

  # CSS / JS / fonts: 1 maand
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Afbeeldingen: 1 jaar (versie verandert via filename hash of ?v=)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/gif "access plus 1 month"
</IfModule>

# Cache-Control headers (immutable voor versie-gehashte assets, no-cache voor html)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|gif|woff2?|ttf|otf|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Veiligheid + crawler-vriendelijk
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Stuur juiste MIME-types (Hostinger doet dit meestal al, voor de zekerheid)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

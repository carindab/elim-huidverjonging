# LiteSpeed (Hostinger): bedankt-pagina + Vite/React SPA
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bestaande bestanden en mappen direct serveren
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /bedankt en /bedankt/ → bedankt.html (statisch buiten de SPA)
  RewriteRule ^bedankt/?$ bedankt.html [L]

  # Overige routes: client-side routing (React)
  RewriteRule . index.html [L]
</IfModule>
